# Pooled connection (app queries). Neon "pooled" URL, often with pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct connection (migrations). Neon "unpooled" / direct URL
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

BETTER_AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Production example: https://ambassador-virid-chi.vercel.app
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Used by `npm run db:seed` — wipes data then creates this admin
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@ambassador.et"
SEED_ADMIN_PASSWORD="change-me-before-production"

